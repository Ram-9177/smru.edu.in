# ----------------------------------------------------------------------
# 🔧 Stmarys Deployment: Ultimate Stability Config
# ----------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Force HTTPS and non-WWW (Canonical Domain smru.edu.in)
    # This prevents 'Link-Access' errors and SSL warnings
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^(.*)$ https://smru.edu.in/$1 [L,R=301]

    # --- Phase 3: templated doorway pages consolidated into authoritative targets ---
    RewriteRule ^(admission\-guides/phd\-next\-cycle\-updates|seo/best\-college\-in\-hyderabad\-checklist|seo/best\-college\-in\-india\-checklist|seo/best\-college\-in\-telangana\-checklist|seo/best\-university\-in\-hyderabad\-checklist|seo/best\-university\-in\-india\-checklist|seo/best\-university\-in\-telangana\-checklist|seo/best\-university\-near\-hyderabad\-india)/?$ https://smru.edu.in/about/ [L,R=301]
    RewriteRule ^(seo/fastest\-growing\-university\-india\-checklist|seo/highest\-salary\-package\-college\-checklist|seo/indias\-first\-university\-claim\-checklist|seo/no1\-college\-in\-india\-checklist|seo/no1\-private\-university\-india\-checklist|seo/placement\-guarantee\-college\-checklist|seo/private\-university\-in\-hyderabad|seo/private\-university\-in\-telangana)/?$ https://smru.edu.in/about/ [L,R=301]
    RewriteRule ^(seo/top\-college\-in\-hyderabad\-checklist|seo/top\-college\-in\-india\-checklist|seo/top\-college\-in\-telangana\-checklist|seo/top\-university\-healthcare\-courses\-india|seo/top\-university\-in\-hyderabad\-checklist|seo/top\-university\-in\-india\-checklist|seo/top\-university\-in\-telangana\-checklist|student\-guides/course\-fees\-comparison\-checklist)/?$ https://smru.edu.in/about/ [L,R=301]
    RewriteRule ^(student\-guides/is\-st\-marys\-university\-same\-as\-smru|student\-guides/placement\-claims\-comparison\-checklist|student\-guides/professional\-approval\-checklist|student\-guides/what\-is\-smru|student\-guides/where\-is\-smru\-located)/?$ https://smru.edu.in/about/ [L,R=301]
    RewriteRule ^(admission\-guides/admission\-last\-date\-check|admission\-guides/apply\-online\-smru|admission\-guides/diploma\-admissions\-2026|admission\-guides/direct\-admission\-smru\-checklist|admission\-guides/fee\-confirmation\-before\-admission|admission\-guides/pg\-admissions\-2026|admission\-guides/refund\-withdrawal\-questions|admission\-guides/smru\-entrance\-exam)/?$ https://smru.edu.in/admissions/ [L,R=301]
    RewriteRule ^(admission\-guides/ug\-admissions\-2026|seo/admissions\-open\-college\-hyderabad|seo/best\-college\-scholarships\-india|seo/top\-private\-university\-admissions\-india|student\-guides/admissions\-office\-hyderabad\-university|student\-guides/course\-selection\-before\-applying|student\-guides/parents\-admission\-checklist|student\-guides/scholarship\-comparison\-checklist)/?$ https://smru.edu.in/admissions/ [L,R=301]
    RewriteRule ^(student\-guides/student\-counselling\-hyderabad\-university|student\-guides/what\-to\-check\-before\-admission)/?$ https://smru.edu.in/admissions/ [L,R=301]
    RewriteRule ^(seo/ugc\-recognized\-university\-hyderabad|seo/ugc\-recognized\-university\-telangana|student\-guides/how\-to\-verify\-university\-recognition|student\-guides/ugc\-recognition\-comparison\-checklist)/?$ https://smru.edu.in/approvals-recognitions/ [L,R=301]
    RewriteRule ^(seo/best\-university\-campus\-facilities\-india|seo/campus\-tour\-university\-hyderabad|student\-guides/campus\-facilities\-comparison\-checklist|student\-guides/campus\-visit\-before\-admission|student\-guides/university\-campus\-visit\-hyderabad|student\-guides/weekend\-campus\-visit\-hyderabad)/?$ https://smru.edu.in/campus-guide/ [L,R=301]
    RewriteRule ^(seo/college\-in\-deshmukhi\-hyderabad|seo/colleges\-near\-ramoji\-film\-city|seo/university\-in\-yadadri\-bhuvanagiri|seo/university\-near\-ramoji\-film\-city|student\-guides/campus\-near\-ramoji\-film\-city\-admissions|student\-guides/college\-near\-deshmukhi|student\-guides/college\-near\-yadadri\-bhuvanagiri|student\-guides/physiotherapy\-near\-ramoji\-film\-city)/?$ https://smru.edu.in/campus-location-hyderabad/ [L,R=301]
    RewriteRule ^(student\-guides/rehabilitation\-hospital\-near\-deshmukhi|student\-guides/university\-near\-pochampally\-mandal)/?$ https://smru.edu.in/campus-location-hyderabad/ [L,R=301]
    RewriteRule ^(student\-guides/campus\-with\-hostel\-hyderabad|student\-guides/hostel\-admission\-questions|student\-guides/hostel\-facilities\-hyderabad)/?$ https://smru.edu.in/hostel/ [L,R=301]
    RewriteRule ^(guides/best\-mba\-college\-in\-hyderabad|guides/best\-pharmacy\-college\-in\-hyderabad)/?$ https://smru.edu.in/schools/ [L,R=301]
