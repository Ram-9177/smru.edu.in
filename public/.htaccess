    RewriteRule ^(admission\-guides/mot\-course\-hyderabad)/?$ https://smru.edu.in/schools/health-allied-health-sciences/occupational-therapy/mot/ [L,R=301]
    RewriteRule ^(admission\-guides/bpt\-admission\-guide|admission\-guides/bpt\-course\-hyderabad|student\-guides/does\-smru\-offer\-bpt)/?$ https://smru.edu.in/schools/health-allied-health-sciences/physiotherapy/bpt/ [L,R=301]
    RewriteRule ^(admission\-guides/mpt\-course\-hyderabad)/?$ https://smru.edu.in/schools/health-allied-health-sciences/physiotherapy/mpt/ [L,R=301]
    RewriteRule ^(admission\-guides/ba\-llb\-hons\-course|admission\-guides/bba\-llb\-hons\-course|admission\-guides/bsc\-llb\-hons\-course|admission\-guides/integrated\-law\-courses|admission\-guides/law\-admissions\-guide|admission\-guides/law\-courses|admission\-guides/llb\-course\-hyderabad|admission\-guides/llb\-hons\-course)/?$ https://smru.edu.in/schools/law/ [L,R=301]
    RewriteRule ^(seo/best\-law\-university\-india|student\-guides/law\-college\-campus\-hyderabad)/?$ https://smru.edu.in/schools/law/ [L,R=301]
    RewriteRule ^(admission\-guides/nursing\-admissions\-guide|admission\-guides/nursing\-courses|seo/best\-nursing\-university\-india|student\-guides/nursing\-college\-campus\-hyderabad)/?$ https://smru.edu.in/schools/nursing-sciences/ [L,R=301]
    RewriteRule ^(admission\-guides/bsc\-nursing\-admission\-guide|admission\-guides/bsc\-nursing\-course\-hyderabad|student\-guides/does\-smru\-offer\-bsc\-nursing)/?$ https://smru.edu.in/schools/nursing-sciences/nursing/bsc-nursing/ [L,R=301]
    RewriteRule ^(admission\-guides/msc\-nursing\-course\-hyderabad)/?$ https://smru.edu.in/schools/nursing-sciences/nursing/msc-nursing/ [L,R=301]
