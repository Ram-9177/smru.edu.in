    RewriteRule ^(admission\-guides/btech\-cse\-admission\-guide|admission\-guides/btech\-cse\-course\-hyderabad|student\-guides/does\-smru\-offer\-btech\-cse)/?$ https://smru.edu.in/schools/engineering-emerging-technologies/computer-science-engineering/btech-cse/ [L,R=301]
    RewriteRule ^(admission\-guides/btech\-cse\-ai\-ds\-course)/?$ https://smru.edu.in/schools/engineering-emerging-technologies/computer-science-engineering/btech-cse-ai-ds/ [L,R=301]
    RewriteRule ^(admission\-guides/btech\-cse\-ai\-ml\-course)/?$ https://smru.edu.in/schools/engineering-emerging-technologies/computer-science-engineering/btech-cse-aiml/ [L,R=301]
    RewriteRule ^(admission\-guides/btech\-rehabilitation\-engineering\-admission|admission\-guides/btech\-rehabilitation\-engineering\-course)/?$ https://smru.edu.in/schools/engineering-emerging-technologies/rehabilitation-engineering-assistive-technologies/btech-rehabilitation-engineering-prosthetics-orthotics-assistive-technologies/ [L,R=301]
    RewriteRule ^(admission\-guides/allied\-health\-technology\-courses|admission\-guides/health\-allied\-health\-sciences\-courses|admission\-guides/health\-sciences\-admissions\-guide|seo/allied\-health\-sciences\-college\-hyderabad|seo/best\-allied\-health\-sciences\-university\-india|seo/best\-health\-sciences\-university\-india|seo/health\-sciences\-university\-hyderabad|student\-guides/allied\-health\-campus\-hyderabad)/?$ https://smru.edu.in/schools/health-allied-health-sciences/ [L,R=301]
    RewriteRule ^(admission\-guides/optometry\-course\-hyderabad)/?$ https://smru.edu.in/schools/health-allied-health-sciences/allied-health-sciences/b-optometry/ [L,R=301]
