    RewriteRule ^(admission\-guides/ma\-clinical\-psychology\-course)/?$ https://smru.edu.in/schools/psychology/clinical-psychology/ma-clinical-psychology/ [L,R=301]
    RewriteRule ^(admission\-guides/professional\-diploma\-clinical\-psychology)/?$ https://smru.edu.in/schools/psychology/clinical-psychology/professional-diploma-clinical-psychology/ [L,R=301]
