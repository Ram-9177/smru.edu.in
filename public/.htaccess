    RewriteRule ^(admission\-guides/bpo\-course\-guide)/?$ https://smru.edu.in/schools/rehabilitation-sciences/prosthetics-orthotics/bpo/ [L,R=301]
    RewriteRule ^(admission\-guides/mpo\-course\-guide)/?$ https://smru.edu.in/schools/rehabilitation-sciences/prosthetics-orthotics/mpo/ [L,R=301]
    RewriteRule ^(seo/best\-baslp\-college\-india)/?$ https://smru.edu.in/seo/baslp-college-hyderabad/ [L,R=301]
    RewriteRule ^(seo/best\-bpt\-college\-india)/?$ https://smru.edu.in/seo/bpt-college-hyderabad/ [L,R=301]
    RewriteRule ^(seo/best\-btech\-cse\-college\-india|seo/btech\-cse\-college\-hyderabad)/?$ https://smru.edu.in/seo/engineering-college-hyderabad/ [L,R=301]
    RewriteRule ^(seo/best\-law\-college\-india|seo/llb\-college\-hyderabad)/?$ https://smru.edu.in/seo/law-college-hyderabad/ [L,R=301]
    RewriteRule ^(seo/best\-bsc\-nursing\-college\-india|seo/bsc\-nursing\-college\-hyderabad)/?$ https://smru.edu.in/seo/nursing-college-hyderabad/ [L,R=301]
    RewriteRule ^(student\-guides/compare\-smru\-with\-other\-universities|student\-guides/contact\-smru\-admissions|student\-guides/documents\-prove\-smru\-status|student\-guides/does\-smru\-have\-hostel|student\-guides/does\-smru\-offer\-law\-courses|student\-guides/how\-to\-apply\-to\-smru|student\-guides/is\-smru\-ugc\-recognized|student\-guides/what\-courses\-does\-smru\-offer)/?$ https://smru.edu.in/smru/ [L,R=301]

    # --- Brand reference consolidation -> /smru/ (Phase 2) ---
    RewriteRule ^(smru-facts|Stmarys-facts|stmarys-facts)/?$ https://smru.edu.in/smru/ [L,R=301,NC]
    RewriteRule ^(st-marys-university|Stmarys-university|stmarys-university|st-marys-rehabilitation-university|Stmarys-university-official|stmarys-university-official)/?$ https://smru.edu.in/smru/ [L,R=301,NC]
    RewriteRule ^(smru-hyderabad|Stmarys-hyderabad|stmarys-hyderabad|rehabilitation-university-hyderabad)/?$ https://smru.edu.in/smru/ [L,R=301,NC]
    RewriteRule ^seo/(st-marys-university|stmarys-university|smru-hyderabad|stmarys-hyderabad|st-marys-rehabilitation-university|stmarys-university-official|stmarys-rehabilitation-university)/?$ https://smru.edu.in/smru/ [L,R=301,NC]
    RewriteRule ^student-guides/(st-marys-university|Stmarys-university|stmarys-university|Stmarys-university-hyderabad|stmarys-university-hyderabad|Stmarys-rehabilitation-university|stmarys-rehabilitation-university|what-is-smru|is-st-marys-university-same-as-smru|where-is-smru-located)/?$ https://smru.edu.in/smru/ [L,R=301,NC]

    # --- Aliases ---
    RewriteRule ^explore-(smru|stmarys)/?$ https://smru.edu.in/explore/ [L,R=301,NC]
    RewriteRule ^Hand-Book/?$ https://smru.edu.in/handbook/ [L,R=301,NC]
    RewriteRule ^Handbook/?$ https://smru.edu.in/handbook/ [L,R=301]
    RewriteRule ^Handbook/(.+\.pdf)$ https://smru.edu.in/assets/handbook/$1 [L,R=301]
    RewriteRule ^iqac/?$ https://smru.edu.in/iqac-quality-assurance/ [L,R=301]
    RewriteRule ^mandatory-disclosure/(ugc-disclosure|statutory-disclosures|contact|first-academic-year-disclosure|public-information)/?$ https://smru.edu.in/mandatory-disclosure/ [L,R=301]
    RewriteRule ^(niat|bb|skilgen|qtst)/?$ https://smru.edu.in/partner/$1/ [L,R=301]
    RewriteRule ^partner/carebridge/?$ https://smru.edu.in/carebridge/ [L,R=301]

    # --- Legacy aliases that also have a client shell under app/ (kept in sync by scripts/redirect-map.mjs) ---
    RewriteRule ^(blackbucks)/?$ https://smru.edu.in/partner/bb/ [L,R=301]
    RewriteRule ^(bytexl)/?$ https://smru.edu.in/partner/bytexl/ [L,R=301]
    RewriteRule ^(carrer)/?$ https://smru.edu.in/careers/ [L,R=301]
    RewriteRule ^(ctpl)/?$ https://apply.smru.edu.in/ [L,R=301]
    RewriteRule ^(edinbox)/?$ https://smru.edu.in/partner/edinbox/ [L,R=301]
    RewriteRule ^(edridge)/?$ https://smru.edu.in/partner/edridge/ [L,R=301]
    RewriteRule ^(emversity)/?$ https://smru.edu.in/partner/emversity/ [L,R=301]
    RewriteRule ^(entrancetest)/?$ https://smru.edu.in/exam-notification/ [L,R=301]
    RewriteRule ^(iiat|ist|mjiollnir|onnbikes|university)/?$ https://smru.edu.in/partner/ [L,R=301]
    RewriteRule ^(nst)/?$ https://smru.edu.in/partner/nst/ [L,R=301]
    RewriteRule ^(qtst-smru)/?$ https://smru.edu.in/partner/qtst/ [L,R=301]
    RewriteRule ^(veloces)/?$ https://smru.edu.in/partner/veloces/ [L,R=301]
    # Legacy /departments/{dept}/ -> canonical /schools/{school}/{dept}/
    RewriteRule ^departments/(allied-health-sciences|occupational-therapy|physiotherapy)/?$ https://smru.edu.in/schools/health-allied-health-sciences/$1/ [L,R=301]
    RewriteRule ^departments/(applied-psychology-behavioural-health|clinical-psychology|rehabilitation-psychology)/?$ https://smru.edu.in/schools/psychology/$1/ [L,R=301]
    RewriteRule ^departments/(audiology-speech-sciences|inclusive-education|prosthetics-orthotics)/?$ https://smru.edu.in/schools/rehabilitation-sciences/$1/ [L,R=301]
    RewriteRule ^departments/(business-administration-computer-applications|computer-science-engineering|rehabilitation-engineering-assistive-technologies|sciences-humanities)/?$ https://smru.edu.in/schools/engineering-emerging-technologies/$1/ [L,R=301]
    RewriteRule ^departments/(legal-studies)/?$ https://smru.edu.in/schools/law/$1/ [L,R=301]
    RewriteRule ^departments/(nursing)/?$ https://smru.edu.in/schools/nursing-sciences/$1/ [L,R=301]

    # --- Duplicate school landings -> canonical /schools/{slug}/ ---
    RewriteRule ^(rehabilitation-sciences|health-allied-health-sciences|psychology|nursing-sciences|engineering-emerging-technologies|law)/?$ https://smru.edu.in/schools/$1/ [L,R=301]

    # 1b. Retired law URLs
    RewriteRule ^schools/law/legal-studies/llb-general/?$ https://smru.edu.in/schools/law/legal-studies/llb/ [L,R=301]
    RewriteRule ^llm/?$ https://smru.edu.in/schools/law/legal-studies/llm/ [L,R=301]
    RewriteRule ^phd-law/?$ https://smru.edu.in/schools/law/legal-studies/phd-law/ [L,R=301]

    # 2. Maintenance Mode Switch (OFF)
</IfModule>

# Serve the branded 404 page instead of the bare server default.
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# SEO/security headers for the static export.
# HSTS is sent on all responses, including www/non-www redirects, so HTTPS-only
# behavior is visible to browsers and crawlers after the first secure request.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/(developer|api)(/|$)" STMARYS_PRIVATE_NOINDEX=1
    SetEnvIf Request_URI "^/thank-you(/|$)" STMARYS_THANKYOU_NOINDEX=1
    # Raw partner-supplied HTML (iframe sources) is partner content, not SMRU's statement: keep it out of the index.
    SetEnvIf Request_URI "^/partners/.*\.html$" STMARYS_PARTNER_RAW_NOINDEX=1
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Baseline hardening. X-Frame-Options only governs who may frame smru.edu.in pages;
    # the partner iframes we embed on our own pages are unaffected.
    # Permissions-Policy deliberately leaves gyroscope/accelerometer/geolocation/fullscreen
    # open: the 360 campus tour relies on device orientation.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(), usb=()"

    # Keep private utility routes out of the index at the HTTP header layer.
    # Public compliance routes, including /mandatory-disclosure/, are not matched here.
    Header always set X-Robots-Tag "noindex, nofollow" env=STMARYS_PRIVATE_NOINDEX
    Header always set X-Robots-Tag "noindex, follow" env=STMARYS_THANKYOU_NOINDEX
    Header always set X-Robots-Tag "noindex, follow" env=STMARYS_PARTNER_RAW_NOINDEX
</IfModule>

# ----------------------------------------------------------------------
# Compression — text assets ship ~4-5x smaller (brotli when the module exists, else gzip).
# Images, woff2, mp4 are already compressed and are deliberately excluded.
# ----------------------------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
    <IfModule mod_headers.c>
        Header append Vary Accept-Encoding
    </IfModule>
</IfModule>

# ----------------------------------------------------------------------
# Caching — explicit Cache-Control. Hashed Next.js assets are immutable for a year; media a month;
# HTML, RSC payloads (index.txt), sitemaps and robots always revalidate so deploys propagate.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|mp4|webm|mp3|pdf|woff2?|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(html|txt|xml|json|webmanifest)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" STMARYS_IMMUTABLE=1
</IfModule>
<IfModule mod_headers.c>
    # Content-hashed build output: cache forever (last so it overrides the generic js/css rule).
    Header set Cache-Control "public, max-age=31536000, immutable" env=STMARYS_IMMUTABLE
</IfModule>
<IfModule mod_expires.c>
    # Fallback for hosts without mod_headers.
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

AddType image/webp .webp

# Block sensitive files
<FilesMatch "(\.env|\.pkg|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

