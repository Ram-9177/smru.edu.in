    RewriteRule ^(admission\-guides/inclusive\-education\-courses|admission\-guides/postgraduate\-rehabilitation\-courses|admission\-guides/rehabilitation\-sciences\-courses|admission\-guides/undergraduate\-rehabilitation\-courses|seo/best\-inclusive\-education\-university\-india|seo/best\-rehabilitation\-university\-india|seo/rehabilitation\-university\-hyderabad|seo/top\-rehabilitation\-university\-india)/?$ https://smru.edu.in/schools/rehabilitation-sciences/ [L,R=301]
    RewriteRule ^(student\-guides/assistive\-technology\-rehabilitation\-hyderabad|student\-guides/audiology\-services\-hyderabad|student\-guides/cardiopulmonary\-rehabilitation\-hyderabad|student\-guides/community\-rehabilitation\-hyderabad|student\-guides/geriatric\-rehabilitation\-hyderabad|student\-guides/mental\-health\-rehabilitation\-hyderabad|student\-guides/neuro\-rehabilitation\-hyderabad|student\-guides/occupational\-therapy\-services\-hyderabad)/?$ https://smru.edu.in/schools/rehabilitation-sciences/ [L,R=301]
    RewriteRule ^(student\-guides/orthopedic\-physiotherapy\-hyderabad|student\-guides/pediatric\-rehabilitation\-hyderabad|student\-guides/physiotherapy\-treatment\-hyderabad|student\-guides/post\-surgery\-rehabilitation\-hyderabad|student\-guides/prosthetics\-orthotics\-services\-hyderabad|student\-guides/rehab\-centre\-hyderabad|student\-guides/rehabilitation\-hospital\-hyderabad|student\-guides/rehabilitation\-university\-campus\-hyderabad)/?$ https://smru.edu.in/schools/rehabilitation-sciences/ [L,R=301]
    RewriteRule ^(student\-guides/speech\-therapy\-services\-hyderabad|student\-guides/sports\-physiotherapy\-hyderabad|student\-guides/water\-therapy\-rehabilitation\-hyderabad)/?$ https://smru.edu.in/schools/rehabilitation-sciences/ [L,R=301]
    RewriteRule ^(admission\-guides/baslp\-admission\-guide|admission\-guides/baslp\-course\-hyderabad)/?$ https://smru.edu.in/schools/rehabilitation-sciences/audiology-speech-sciences/baslp/ [L,R=301]
    RewriteRule ^(admission\-guides/msc\-audiology\-course)/?$ https://smru.edu.in/schools/rehabilitation-sciences/audiology-speech-sciences/msc-audiology/ [L,R=301]
